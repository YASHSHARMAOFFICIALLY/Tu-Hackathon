# Neon Postgres connection string.
# Neon Console > your project > Connection Details. Use the POOLED string
# (host contains "-pooler") for the app; the HTTP driver is happy with either.
# Copy this file to .env.local — .env* is gitignored, never commit real values.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Session signing key. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the app. Production: https://yourdomain.com
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI triage (OPTIONAL) ---------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey  (generous free tier)
# Without this the app runs normally, just without AI suggestions.
GEMINI_API_KEY=""
# Override only if you want a different model; defaults are set in src/env.ts.
# GEMINI_MODEL="gemini-2.0-flash"
# GEMINI_EMBEDDING_MODEL="text-embedding-004"
